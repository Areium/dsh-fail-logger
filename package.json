{
  "name": "ptc-fail-logger",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 插件：自动把 PTC（Code Mode）code run 失败实录写入 ptc-code-run-guide skill 的机器维护区段——按错因去重计数，下次会话模型加载 skill 时即可看到高频错因，减少重复犯错。Auto-log PTC code-run failures into a skill's machine-maintained section (dedup + counts).",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js",
    "test": "node tests/test.mjs",
    "prepublishOnly": "npm run check && npm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-github-user>/ptc-fail-logger.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-mode",
    "ptc",
    "fail-logger",
    "skill"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
